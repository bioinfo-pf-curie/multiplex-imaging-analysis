Bootstrap: docker
From: python:3.11

%post
  apt-get -y update
  apt-get install -y python3-opencv g++ python3-dev python-pip
  rm -rf /var/lib/apt/lists/* 
  python -m pip install -U pip setuptools wheel Cython
  python -m pip install --no-cache-dir \
    pandas==2.1.1 \
    numpy==1.25.2 \
    tifffile==2023.4.12 \
    scikit-image==0.23.1 \
    ome_types==0.4.2 \
    zarr==2.16.1 \
    opencv-python-headless==4.8.1.78 \
    pydantic==2.8.2 \
    h5py==3.9.0 \
    xsdata==23.8 \
    shapely==2.0.1 \
    dask==2023.6.0 \
    distributed==2023.6.0 \
    psutil==5.9.6 \
    rasterio==1.3.10 \
    imagecodecs==2024.12.30 \
    numcodecs==0.15.0 \
    plotly==5.24.1 \
    multiqc==1.25.2 \
    readimc==0.8.0
  python -m pip install fastremap==1.13.4 --no-binary :all:
